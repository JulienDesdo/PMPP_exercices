# Local lab only. Do not reuse these credentials elsewhere.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
GRAFANA_URL=http://localhost:3000
GRAFANA_DASHBOARD_UID=minecraft-gpu-lab

GPU_INDEX=0
EXPORTER_PORT=9835
SAMPLE_INTERVAL_SECONDS=1

# Optional: set the exact Minecraft javaw.exe PID if auto-detection picks the wrong Java process.
# MINECRAFT_PID=39540

# Optional: install PresentMon and point to PresentMon.exe for FPS / frametime telemetry.
# PRESENTMON_PATH=C:\Tools\PresentMon\PresentMon.exe
